Ref: product.product_skus.uom_id > product.unit_of_measurements.uom_id
Ref: product.product_skus.product_type_id > product.product_types.product_type_id
Ref: product.product_types.merchant_id > configuration.merchants.merchant_id // cross-service id, no FK
Ref: product.stock_controllers.uom_id > product.unit_of_measurements.uom_id

