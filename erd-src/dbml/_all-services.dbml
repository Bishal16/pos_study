Ref: inventory.consumeable_item_ledgers.consumeable_stock_id > inventory.consumeable_stocks.consumeable_stock_id
Ref: inventory.consumeable_stocks.merchant_id > configuration.merchants.merchant_id // cross-service id, no FK
Ref: inventory.consumeable_stocks.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: inventory.inventory_stock_thresholds.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: inventory.inventory_stock_threshold_history.inventory_stock_threshold_id > inventory.inventory_stock_thresholds.inventory_stock_threshold_id
Ref: inventory.inventory_stock_threshold_history.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: inventory.item_ledgers.stock_summary_id > inventory.product_stock_summary.stock_summary_id
Ref: inventory.line_rack_floors.grid_id > inventory.line_rack_grids.rack_grid_id
Ref: inventory.line_rack_grids.rack_id > inventory.store_zone_line_racks.rack_id
Ref: inventory.pos_store_houses.store_house_type_id > inventory.store_house_types.store_house_type_id
Ref: inventory.pos_store_houses.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: inventory.pos_store_house_rents.pos_store_id > inventory.pos_store_houses.pos_store_id
Ref: inventory.pos_store_house_rent_history.pos_store_id > inventory.pos_store_houses.pos_store_id
Ref: inventory.pos_store_house_zones.pos_store_id > inventory.pos_store_houses.pos_store_id
Ref: inventory.pos_store_zone_lines.pos_store_house_zone_id > inventory.pos_store_house_zones.pos_store_house_zone_id
Ref: inventory.product_instances.stock_summary_id > inventory.product_stock_summary.stock_summary_id
Ref: inventory.product_instances.delivery_product_controller_id > purchase.do_product_controllers.id // cross-service id, no FK
Ref: inventory.product_stock_summary.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: inventory.rack_grid_containers.rack_floor_id > inventory.line_rack_floors.rack_floor_id
Ref: inventory.sales_hub_allocated_spaces.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: inventory.store_house_types.merchant_id > configuration.merchants.merchant_id // cross-service id, no FK
Ref: inventory.store_zone_line_racks.pos_store_zone_line_id > inventory.pos_store_zone_lines.pos_store_zone_line_id

