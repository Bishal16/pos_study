Ref: sales.sales_invoices.customer_account_id > accounts.customer_accounts.customer_account_id // cross-service id, no FK
Ref: sales.sales_invoices.sales_by_employee_id > authentication.employees.id // cross-service id, no FK
Ref: sales.sales_invoices.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: sales.sales_invoices.sales_offer_id > sales.sales_offers.sales_offer_id
Ref: sales.sales_invoice_gift_voucher_extensions.sales_invoice_id - sales.sales_invoices.sales_invoice_id
Ref: sales.sales_invoice_hire_extensions.sales_invoice_id - sales.sales_invoices.sales_invoice_id
Ref: sales.sales_invoice_hire_guarantors.sales_invoice_id > sales.sales_invoices.sales_invoice_id
Ref: sales.sales_invoice_hire_guarantors.person_id > customer.persons.person_id // cross-service id, no FK
Ref: sales.sales_invoice_retail_extensions.sales_invoice_id - sales.sales_invoices.sales_invoice_id
Ref: sales.sales_invoice_retail_extensions.reference_employee_id > authentication.employees.id // cross-service id, no FK
Ref: sales.sales_offers.merchant_id > configuration.merchants.merchant_id // cross-service id, no FK
Ref: sales.transaction_prefix_configurations.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: sales.sales_lines.sales_invoice_id > sales.sales_invoices.sales_invoice_id
Ref: sales.sales_serial_numbers.sales_line_id > sales.sales_lines.sales_line_id
Ref: sales.sales_returns.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: sales.sales_returns.customer_id > customer.persons.person_id // cross-service id, no FK
Ref: sales.sales_return_line.sales_return_id > sales.sales_returns.sales_return_id
Ref: sales.sales_return_line.sale_line_id > sales.sales_lines.sales_line_id
Ref: sales.sales_return_serial_numbers.sales_return_line_id > sales.sales_return_line.sales_return_line_id
Ref: sales.sales_target_monthly.sales_target_yearly_id > sales.sales_target_yearly.sales_target_yearly_id
Ref: sales.sales_target_monthly.sales_target_head_id > sales.sales_target_heads.target_head_id
Ref: sales.sales_target_yearly.sales_hub_id > configuration.business_areas.business_area_id // cross-service id, no FK
Ref: sales.sales_target_yearly.sales_target_head_id > sales.sales_target_heads.target_head_id
Ref: sales.sales_target_heads.target_head_type_id > sales.sales_target_head_types.target_head_type_id
Ref: sales.sales_target_head_types.merchant_id > configuration.merchants.merchant_id // cross-service id, no FK

